# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY=

# APP_URL: The URL where this applet is hosted.
APP_URL=

# WINDY_MAP_KEY: Optional custom Windy Map Forecast API developer key.
VITE_WINDY_MAP_KEY=

# WINDY_POINT_KEY: Optional custom Windy Point Forecast API query developer key.
VITE_WINDY_POINT_KEY=

# GOOGLE_ANALYTICS: Optional Google Analytics GA4 Measurement ID (e.g. G-XXXXXX).
VITE_GA_MEASUREMENT_ID=

# GOOGLE_APPS_SCRIPT: Optional Apps Script webhook URL.
VITE_APPS_SCRIPT_URL=
